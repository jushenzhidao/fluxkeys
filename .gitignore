/fluxkeys-gateway
/initdb
*.exe
*.test
*.out
coverage.out
coverage.html
*.prof

# 本地配置覆盖（生产 YAML 可能含真实出口 IP 等环境信息）
config.local.yaml
config.local.yml
docker-compose.override.yml


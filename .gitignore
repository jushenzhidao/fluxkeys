# ⚠️ 最重要的一条：.env 里有 POSTGRES_PASSWORD / ADMIN_API_KEY /
# FLUXKEYS_ENCRYPTION_KEY，一旦提交等于密钥公开。.env.example 是模板，需要提交。
.env
.env.*
!.env.example

# 私钥与证书
*.pem
*.key
*.crt
!**/testdata/**

# Go 构建产物
/bin/
/dist/
/out/
# 根目录直接 go build 出的二进制（27MB，绝不能进库）
/gateway
/fluxkeys-gateway
/mockark
/initdb
*.exe
*.test
*.out
coverage.out
coverage.html
*.prof

# 本地配置覆盖（生产 YAML 可能含真实出口 IP 等环境信息）
config.local.yaml
config.local.yml
docker-compose.override.yml

# 真实上游测试目录：keys.txt 含真实商汤密钥、deploy 脚本含服务器 IP 与
# SSH 凭据、config.prod.yaml 含生产拓扑。整目录不入库。
/real_upstream_test/
# 同理：根目录部署脚本含明文 root SSH 密码与服务器 IP。
/deploy_test.sh
/test_local.sh

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# 编辑器 / OS
.idea/
.vscode/
.DS_Store
*.swp

# Agent 工作目录
.workbuddy/

# FluxKeys 环境变量示例
#
# 用法：cp deploy/.env.example .env
# 修改标注 [必填] 的项后再启动。docker compose 会自动读取项目根目录的 .env。
#
# 注意：本文件仅作示例，不要把真实凭据提交进版本库。

# ==========================================================
# 凭据 [必填]
# ==========================================================

# 管理 API 的访问凭据。留空会导致管理端点无法鉴权，务必修改。
ADMIN_API_KEY=change-me-admin-key

# 上游 Key 的落库加密密钥。必须为 32 字节。
# 生成：openssl rand -hex 16
FLUXKEYS_ENCRYPTION_KEY=change-me-32-bytes-encryption-key

# ==========================================================
# 数据存储
# ==========================================================

POSTGRES_PASSWORD=fluxkeys
# 应用侧连接串。compose 内网使用服务名 postgres。
POSTGRES_DSN=postgres://fluxkeys:fluxkeys@postgres:5432/fluxkeys?sslmode=disable

# Redis 是配额的唯一权威写路径，生产环境务必设置密码。
REDIS_PASSWORD=
REDIS_ADDR=redis:6379
REDIS_DB=0

# ==========================================================
# 服务监听
# ==========================================================

FLUXKEYS_ADDR=:8080
FLUXKEYS_METRICS_ADDR=:9090

# 宿主机端口映射
GATEWAY_HOST_PORT=8080
GATEWAY_METRICS_HOST_PORT=9090
DASHBOARD_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3000

# ==========================================================
# 上游
# ==========================================================

# 默认指向内置 mock，便于本地联调。
# 接真实火山引擎改为：https://ark.cn-beijing.volces.com/api/v3
VOLC_BASE_URL=http://mockark:18080

# 单 Key 单日 token 配额硬上限
QUOTA_TOKEN_LIMIT=5000000

# ==========================================================
# 推理模型预扣调优
# ==========================================================

# 推理模型（deepseek / thinking / -r1 等）的思维链 token 不受 max_tokens
# 约束，实测 completion_tokens 可达 max_tokens 的 1.89 倍以上，小 max_tokens
# 场景下更高。以下两项用于避免预扣被系统性击穿。
#
# 输出部分的额外放大系数
QUOTA_REASONING_OUTPUT_MULTIPLIER=3.0
# 输出部分的预扣下限。max_tokens 很小时放大系数不足以兜底，由该下限补足。
QUOTA_REASONING_FLOOR_TOKENS=1024

# ==========================================================
# 出口 IP
# ==========================================================

# direct：直连；proxy：按 Key 绑定固定出口 IP
EGRESS_MODE=direct
# proxy 模式下的映射，形如 172.16.0.2=1.2.3.4,172.16.0.3=1.2.3.5
EGRESS_IPS=
EGRESS_VERIFY_ON_START=false

# ==========================================================
# 其他
# ==========================================================

REFRESH_ENABLED=false
GRAFANA_ADMIN_PASSWORD=admin

# 仪表盘登录凭据
DASHBOARD_PASSWORD=change-me-dashboard-password
# 会话签名密钥，生成：openssl rand -hex 32
DASHBOARD_SESSION_SECRET=change-me-session-secret

# 构建元信息，通常由 CI 注入
FLUXKEYS_IMAGE_TAG=dev
GIT_COMMIT=unknown
BUILD_TIME=unknown

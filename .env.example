# FluxKeys 环境变量样例
#
# 用法:
#   cp .env.example .env
#   # 按下面注释生成密钥；生产推荐直接跑 bash scripts/gen-prod-env.sh
#   docker compose up -d
#
# 安全约定:
#   .env 已在 .gitignore 中，绝不提交。compose 文件里不硬编码任何真实密钥。
#   compose 对所有参数都给了开箱默认值（保证一条命令可裸跑验证），但密钥类
#   默认值都是 CHANGE_ME / change-me 形态的占位符 —— 正式部署必须换成强随机值，
#   其中 FLUXKEYS_ENCRYPTION_KEY 一旦导入过火山 Key 就无法直接更换。

# ============================================================================
# 必填：三个敏感项
# ============================================================================

# Postgres 密码。生成: openssl rand -base64 24 | tr -d '/+=' | head -c 24
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Redis 密码。生成: openssl rand -hex 24
#
# 留空不会变成「免密」—— compose 侧写的是 ${REDIS_PASSWORD:-change-me-...}，
# 空值会落回占位默认值。要真正免密运行只能显式改成空串（不推荐，回环上
# 任何 host 网络容器都能直连 Redis）。
#
# 注意: 改这个值后必须 docker compose down 再 up。Redis 的 requirepass 是
# 启动参数，仅 restart 容器不会重读 .env。
REDIS_PASSWORD=CHANGE_ME_redis_password

# 管理接口鉴权密钥。为空则 /admin/* 禁用（compose 侧默认即为空）。
# 生成: openssl rand -hex 32
#
# 看板转发管理操作时会以 GATEWAY_ADMIN_API_KEY 复用这同一个值（见
# docker-compose.yml）。两侧必须一致，否则看板的所有写操作都会被网关拒掉。
# 这个值只在服务端之间流转，绝不下发到浏览器。
ADMIN_API_KEY=CHANGE_ME_admin_api_key

# 看板管理控制台的登录口令。至少 12 个字符。
#
# 缺失或过短则看板**拒绝启动** —— 管理控制台能改 Key 状态、导入密钥、
# 换出口 IP，静默降级为无鉴权等于把这些能力对外敞开。
DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password

# 看板会话签名密钥。至少 32 个字符。
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 两点必须注意：
#   1. 多副本部署时所有副本必须配同一个值，否则用户在副本间跳转会反复掉登录；
#   2. 轮换这个值即让全部已签发会话立即失效 —— 这是共享口令模型下唯一的
#      「踢人」手段（无状态会话没有服务端记录可删）。
#
# 应急处置（口令泄漏 / 怀疑 Cookie 被人拿到）：
#   改这个值并重启看板。**不要指望让用户点登出** —— POST /logout 只让浏览器
#   丢弃 Cookie，那个 token 在服务端仍然有效，直到 DASHBOARD_SESSION_TTL
#   到期为止（见 ADR-001 的 Consequences）。
#
#   多副本时每个副本都要改并重启，漏掉一个，那个副本上的旧 token 照样能用。
DASHBOARD_SESSION_SECRET=CHANGE_ME_dashboard_session_secret_min32

# 看板会话有效期（秒）。默认 7200（2 小时）。
#
# 这个值不只是「多久要重新登录」，它同时是**登出后 token 仍可被重放的最长
# 时间**。无状态签名会话无法在服务端吊销单个 token，所以 TTL 就是风险窗口的
# 实际长度 —— 调大它等于按同样倍数放大这个窗口。
#
# 共享机器上用完请关闭浏览器，只点登出不足以让 token 失效。
DASHBOARD_SESSION_TTL=7200

# 火山 Key secret 的加密主密钥，必须是 32 字节的 hex（64 个字符）。
# 生成: openssl rand -hex 32
#
# 警告: 这个密钥丢了，库里所有 volc_keys.secret_enc 就永久解不开了。
#       换这个密钥必须先用旧密钥全量解密再用新密钥重新加密，不能直接替换。
FLUXKEYS_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_0000000000000000000000000000000000000000

# ============================================================================
# 出口模式 —— 本部署形态的核心，不是可选项
# ============================================================================

# multi_ip = 生产多 EIP，按 Key 绑定源地址（默认）。
#            必须先在宿主机跑 scripts/setup-egress.sh 配好策略路由，否则绑定会
#            静默失效（请求照常成功但全部走主 IP，架构评审 P1-6）。
# direct   = 单出口。仅过渡环境显式降级使用 —— 所有 Key 共用主 IP 出口，
#            隔离收益归零，且这是风控最敏感的特征。
EGRESS_MODE=multi_ip

# 出口地址来源一: 显式清单。格式: 本机地址=对应公网EIP，逗号分隔。
# 例: EGRESS_IPS=172.16.0.11=203.0.113.11,172.16.0.12=203.0.113.12
# 也可带档位与容量: 172.16.0.11=203.0.113.11|hot|10
# 为空则 gateway 启动即失败（multi_ip 必须配置 egress.ips）—— 快速失败优于
# 静默共用主 IP。
EGRESS_IPS=

# 出口地址来源二: 扫描本机网卡。留空 = 用上面的 EGRESS_IPS；
# 设成 scan = 扫描本机网卡上符合条件的 IPv4 地址（自动排除回环、链路本地
# 169.254/16、docker0 / br-* / veth / tun 等虚拟网卡），再按镜像内置档位
# （configs/config.prod.yml 的 egress.scan 段）分档填充。
#
# 两者**互斥**: 同时设置会被配置校验拒绝启动 —— 静默择一会让「以为生效的那条」
# 其实没生效（出口集合多几个或少几个，却没有任何提示）。用扫描时清空 EGRESS_IPS。
#
# ⚠️ 切换前核对本机可用地址数与内置分档计划（19 hot / 5 warm / 8 cold）是否相符:
#    地址不足会拒绝启动，而不是缩水运行 —— 缩水会静默丢掉「出口被封时其上 Key
#    有地方可去」的撤离余量。
EGRESS_IPS_SOURCE=

# 启动时逐个 IP 用绑定源地址拨测一次上游，任一失败即拒绝启动。
# 在改完策略路由、或出口网络有变动后，这是唯一能自动发现「绑定其实没生效」的机制。
EGRESS_VERIFY_ON_START=true

# ============================================================================
# 上游地址
# ============================================================================

# volc 上游地址。**默认注释掉是有意的** —— 环境变量优先级高于 -config YAML，
# 只要 VOLC_BASE_URL 恒非空，配置文件（configs/*.yml）与 /admin/providers 就
# 永远无法覆盖它，provider 地址的单一真相来源就被破坏。
#
# 实测踩过（livetest-ai E2E-FK-VOLCENV-OVERRIDE）: 夹具配置把 volc 指向本地
# 假上游，但 .env 与 compose 的默认值把地址盖回真实火山 —— 假 Key 打到真实
# 上游，返回 401 并把出口 IP 打进封禁名单，而配置看起来「已经改对了」。
#
# 不写它时的地址来自 internal/config/defaults.go 的内置默认值（即真实火山
# 地址），所以生产形态无需这一行。仅在需要把 volc 指向别的上游
# （自建代理 / 联调环境）时才取消注释。
#
# 另注: compose 形态不内置假上游（原 mockark 服务与镜像已移除），业务链路需要
# 真实火山 Key；无 Key 的离线全链路验证走 go test ./test/...（进程内假上游）
# 或 scripts/local-e2e-check.sh。
# VOLC_BASE_URL=https://ark.cn-beijing.volces.com

# ============================================================================
# 刷新探测（P0-4）
# ============================================================================

# 不开的话 00:00-12:00 会按满额度调度已耗尽的 Key，直接导致超刷，故默认 true。
# 允许覆盖是为了避免「配置项写进 .env 却不生效」这类坑 —— 把它设成 false 是
# 一个明知故犯的决定。
REFRESH_ENABLED=true

# ============================================================================
# 配额水位
# ============================================================================

# 单 Key 每日 Token 上限。火山赠送 500 万。
# 硬水位比例 0.90 / 软水位 0.80 在 config 默认值里，需要调则改 config 文件。
QUOTA_TOKEN_LIMIT=5000000

# 看板显示「接近水位」用的绝对值。compose 不支持算术 —— 改上面
# QUOTA_TOKEN_LIMIT 时必须手工同步这两个值（hard = limit × 0.90），
# 否则看板的水位判断与网关实际调度不符。
# QUOTA_TOKEN_HARD=4500000
# QUOTA_COUNT_HARD=90

# ----------------------------------------------------------------------------
# 推理模型预扣调优（config.go 的 applyEnv 支持，留空走代码默认值 3.0 / 1024）。
# 真实输出倍率随模型版本漂移，这里改完重启容器即生效，无需重建镜像。
# ----------------------------------------------------------------------------
# QUOTA_REASONING_OUTPUT_MULTIPLIER=3.0
# QUOTA_REASONING_FLOOR_TOKENS=1024

# ----------------------------------------------------------------------------
# 出口封禁自动判定（默认 0 = 关闭，开启必须 >=3）。
# 判据: 窗口内 >= N 个不同 Key 从同一出口失败，才判定出口被上游拉黑。
# COOLDOWN 是判定后的首次等待时长，MAX 是反复被封的指数退避上限。
# 时长格式: 10m / 2h / 24h。
# ----------------------------------------------------------------------------
# EGRESS_BAN_DETECT_KEYS=0
# EGRESS_BAN_DETECT_WINDOW=10m
# EGRESS_BAN_COOLDOWN=2h
# EGRESS_BAN_COOLDOWN_MAX=24h

# ============================================================================
# 监听地址
# ============================================================================

# 业务监听地址。host 网络下这是**宿主机端口本身**（没有 ports 映射这一层），
# 默认 :8080 即所有网卡。要换端口或改成只绑内网，直接改这里。
FLUXKEYS_ADDR=:8080

# 指标地址。compose 里默认写的是 127.0.0.1:9090（host 网络下写 :9090 等于把
# 出口 IP 信誉等运维数据暴露公网）。改成别的地址时必须同步改
# deploy/prometheus.yml 的抓取 target，否则告警会静默失效 —— 所以这里保持注释。
# FLUXKEYS_METRICS_ADDR=127.0.0.1:9090

# 日志级别。取值 debug / info（默认）/ warn / error。
# 日志恒为 JSON 结构化输出到 stdout，生产可直接被采集器收录；级别只影响
# 输出量，不影响格式。不设该变量时等价于 info。
# FLUXKEYS_LOG_LEVEL=info

# ============================================================================
# 宿主机端口映射（避免与本机已有服务冲突时改这里）
# ============================================================================
# 注意: gateway 走 host 网络，它的端口没有映射层，由 FLUXKEYS_ADDR 决定。
DASHBOARD_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3000
# Redis/Postgres 固定绑回环。改端口用下面两个变量（改了之后 .env 里的
# POSTGRES_DSN / compose 内的地址无需同步 —— 都指向 127.0.0.1 的同端口）。
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ============================================================================
# Grafana
# ============================================================================
# 仅在首次创建 grafana-data 卷时生效，之后改这里不会更新密码
# （重置需删卷重建或进 UI 修改）。对外暴露前必须改掉默认值。
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================================
# 镜像版本（release.yml 推到 ghcr 后，用具体 tag 而非 latest）
# ============================================================================
FLUXKEYS_IMAGE_TAG=dev

# 构建元信息，注入后作为容器标签暴露给 /metrics 与看板。CI 自动填，
# 手工部署可留空 —— compose 侧写的是 ${GIT_COMMIT:-unknown}，缺省不报错。
# GIT_COMMIT=
# BUILD_TIME=

# ============================================================================
# 启用哪些 compose profile
# ============================================================================
# monitoring = prometheus + grafana
# backup     = Postgres 每日逻辑备份到命名卷（强烈建议开）
# tls        = Caddy 自动 HTTPS 反代 gateway（自建 Nginx 则不开，需填 CADDY_DOMAIN）
COMPOSE_PROFILES=monitoring,backup

# ============================================================================
# 调优档（gateway 的 YAML 配置 —— 已内置进镜像，不挂宿主机目录）
# ============================================================================
# 为什么需要它: 本文件只被映射了 17 个变量（见 internal/config/env.go），
# redis.pool_size / postgres.max_conns / quota.reap_* / scheduler.* 这些
# **没有 env 出口** —— 没有档位文件，它们在容器里根本调不了。
#
# 档位文件在构建期被 COPY 进镜像的 /etc/fluxkeys/（源文件在 configs/），
# 所以：改档位内容必须**重建镜像**；这里只是选哪一档。
#
# prod（默认）= 只补容量，不动风控姿态（单 Key 间隔仍是 5s）
# loadtest    = 关闭单 Key 节流与档位配比，**仅压测**，先读文件头的代价说明
#
# 优先级是 环境变量 > YAML > 内置默认值，所以本文件里的密钥/EGRESS_IPS 等
# 继续生效，与档位文件不冲突。
FLUXKEYS_TUNING=prod

# ============================================================================
# 多机分片
# ============================================================================

# 本实例的分片标识。留空 = 单机模式（全量装载全部 Key）。
#
# 非空时本实例只装载 shard 等于该值的 Key —— 多台机器共用同一份配置与镜像，
# 唯一差异就是这个值，所以它刻意走环境变量而非 YAML。
# 属冷配置: 改机器归属涉及云厂商侧出口 IP 重绑定，本就要重启进程。
# 注意: 多机只切分出口层，Redis/Postgres 仍是共享单点，否则同一用户会在
# 不同机器上各拿一份配额。
# FLUXKEYS_SHARD_ID=

# ============================================================================
# 备份与 TLS（分别对应 backup / tls profile）
# ============================================================================

# 备份间隔与保留天数，默认 24h / 14 天
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14

# 对外域名与 ACME 邮箱（仅启用 tls profile 时需要，域名无法默认化）
# CADDY_DOMAIN=api.example.com
# ACME_EMAIL=ops@example.com

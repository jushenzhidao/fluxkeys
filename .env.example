# FluxKeys 环境变量样例
#
# 用法:
#   cp .env.example .env
#   # 按下面注释生成三个必填密钥，然后 docker compose up -d
#
# 安全约定:
#   .env 已在 .gitignore 中，绝不提交。compose 文件里不硬编码任何真实密钥，
#   全部通过 ${VAR:?} 从这里读取，缺失时 compose 会直接报错而非静默用空值启动。

# ============================================================================
# 必填：三个敏感项
# ============================================================================

# Postgres 密码。生成: openssl rand -base64 24 | tr -d '/+=' | head -c 24
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Redis 密码。留空则不启用 requirepass（仅当 Redis 不映射到宿主机时可接受）。
# 生产建议设置。生成: openssl rand -hex 24
#
# 注意: 改这个值后必须 docker compose down 再 up。Redis 的 requirepass 是
# 启动参数，仅 restart 容器不会重读 .env。
REDIS_PASSWORD=

# 管理接口鉴权密钥。为空则 /admin/* 禁用。
# 生成: openssl rand -hex 32
#
# 看板转发管理操作时会以 GATEWAY_ADMIN_API_KEY 复用这同一个值（见
# docker-compose.yml）。两侧必须一致，否则看板的所有写操作都会被网关拒掉。
# 这个值只在服务端之间流转，绝不下发到浏览器。
ADMIN_API_KEY=CHANGE_ME_admin_api_key

# 看板管理控制台的登录口令。至少 12 个字符。
#
# 缺失或过短则看板**拒绝启动** —— 管理控制台能改 Key 状态、导入密钥、
# 换出口 IP，静默降级为无鉴权等于把这些能力对外敞开。
DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password

# 看板会话签名密钥。至少 32 个字符。
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 两点必须注意：
#   1. 多副本部署时所有副本必须配同一个值，否则用户在副本间跳转会反复掉登录；
#   2. 轮换这个值即让全部已签发会话立即失效 —— 这是共享口令模型下唯一的
#      「踢人」手段（无状态会话没有服务端记录可删）。
#
# 应急处置（口令泄漏 / 怀疑 Cookie 被人拿到）：
#   改这个值并重启看板。**不要指望让用户点登出** —— POST /logout 只让浏览器
#   丢弃 Cookie，那个 token 在服务端仍然有效，直到 DASHBOARD_SESSION_TTL
#   到期为止（见 ADR-001 的 Consequences）。
#
#   多副本时每个副本都要改并重启，漏掉一个，那个副本上的旧 token 照样能用。
DASHBOARD_SESSION_SECRET=CHANGE_ME_dashboard_session_secret_min32

# 看板会话有效期（秒）。默认 7200（2 小时）。
#
# 这个值不只是「多久要重新登录」，它同时是**登出后 token 仍可被重放的最长
# 时间**。无状态签名会话无法在服务端吊销单个 token，所以 TTL 就是风险窗口的
# 实际长度 —— 调大它等于按同样倍数放大这个窗口。
#
# 共享机器上用完请关闭浏览器，只点登出不足以让 token 失效。
DASHBOARD_SESSION_TTL=7200

# 火山 Key secret 的加密主密钥，必须是 32 字节的 hex（64 个字符）。
# 生成: openssl rand -hex 32
#
# 警告: 这个密钥丢了，库里所有 volc_keys.secret_enc 就永久解不开了。
#       换这个密钥必须先用旧密钥全量解密再用新密钥重新加密，不能直接替换。
FLUXKEYS_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_0000000000000000000000000000000000000000

# ============================================================================
# 出口模式（这是本地 vs 生产最关键的开关）
# ============================================================================

# direct   = 单出口，走容器默认网络。本地/CI 用这个，开箱即跑。
# multi_ip = 生产多 EIP，按 Key 绑定源地址。切换前必须先在宿主机跑
#            scripts/setup-egress.sh 配好策略路由，否则绑定会「静默失效」
#            （请求照常成功但全部走主 IP，架构评审 P1-6）。
EGRESS_MODE=direct

# 仅 multi_ip 模式需要。格式: 本机地址=对应公网EIP，逗号分隔。
# 例: EGRESS_IPS=172.16.0.11=203.0.113.11,172.16.0.12=203.0.113.12
EGRESS_IPS=

# 启动时校验每个出口 IP 的连通性。生产建议 true（宁可启动失败也不要静默走错出口）。
EGRESS_VERIFY_ON_START=false

# ============================================================================
# 上游地址
# ============================================================================

# 默认指向 compose 内的 mockark 假上游 —— 这是「docker compose up 即可离线
# 跑通全链路」的关键，无需任何真实火山 Key。
#
# 切生产改为: VOLC_BASE_URL=https://ark.cn-beijing.volces.com
VOLC_BASE_URL=http://mockark:18080

# ============================================================================
# 刷新探测（P0-4）
# ============================================================================

# 本地默认关闭。开着的话 12:00-14:00 窗口会对 mockark 发探测请求，
# 干扰本地调试且没有意义。生产必须 true，否则 00:00-12:00 会按满额度
# 调度已耗尽的 Key，直接导致超刷。
REFRESH_ENABLED=false

# ============================================================================
# 配额水位
# ============================================================================

# 单 Key 每日 Token 上限。火山赠送 500 万。
# 硬水位比例 0.90 / 软水位 0.80 在 config 默认值里，需要调则改 config 文件。
QUOTA_TOKEN_LIMIT=5000000

# ============================================================================
# 监听地址（一般不用改）
# ============================================================================
FLUXKEYS_ADDR=:8080
FLUXKEYS_METRICS_ADDR=:9090

# ============================================================================
# 宿主机端口映射（避免与本机已有服务冲突时改这里）
# ============================================================================
GATEWAY_HOST_PORT=8080
GATEWAY_METRICS_HOST_PORT=9090
DASHBOARD_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3000

# Postgres/Redis 默认不映射到宿主机（见 compose 注释）。
# 需要用 psql/redis-cli 直连调试时，取消 compose 里对应 ports 的注释。

# ============================================================================
# Grafana
# ============================================================================
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================================
# 镜像版本（release.yml 推到 ghcr 后，生产用具体 tag 而非 latest）
# ============================================================================
FLUXKEYS_IMAGE_TAG=dev

# ============================================================================
# 启用哪些 compose profile
# ============================================================================
# mock       = 启动 mockark 假上游（本地必开，生产去掉）
# monitoring = 启动 prometheus + grafana
#
# 本地默认全开，`docker compose up -d` 即可跑通全链路。
# 生产改为: COMPOSE_PROFILES=monitoring
COMPOSE_PROFILES=mock,monitoring
